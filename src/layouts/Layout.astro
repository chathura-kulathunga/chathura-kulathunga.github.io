---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

const { title = "CK // Vault" } = Astro.props;

const pathname = Astro.url.pathname;
const isHome =
  pathname === "/" || pathname === "/index.html" || pathname === "";
const isVault =
  pathname.startsWith("/vault") ||
  pathname.startsWith("/project") ||
  pathname.startsWith("/labs") ||
  pathname.startsWith("/dojo") ||
  pathname.startsWith("/robotics") ||
  pathname.startsWith("/music") ||
  pathname.startsWith("/psychology");
const isCredentials = pathname.startsWith("/credentials");
const isAbout = pathname.startsWith("/about");
const isContact = pathname.startsWith("/contact");

const navItems = [
  { href: "/", label: "Home", active: isHome },
  { href: "/vault", label: "Vault", active: isVault },
  { href: "/credentials", label: "Credentials", active: isCredentials },
  { href: "/about", label: "About", active: isAbout },
  { href: "/contact", label: "Contact", active: isContact },
];
---

<html lang="en" class="dark bg-[#F8F9FA] dark:bg-[#121212]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>

    {isHome && (
      <link
        rel="preload"
        as="image"
        href="/Chathura-Kulathunga-2025.jpg"
        fetchpriority="high"
      />
    )}

    <ClientRouter />

    <link rel="icon" type="image/png" href="/favicon.png?v=2" />
    <link rel="apple-touch-icon" href="/favicon.png?v=2" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;900&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      const applyTheme = (doc = document) => {
        const isLight =
          typeof localStorage !== "undefined" &&
          localStorage.getItem("theme") === "light";
        doc.documentElement.classList.toggle("dark", !isLight);
        doc.documentElement.style.colorScheme = isLight ? "light" : "dark";
      };
      applyTheme();
      if (!window.__ckThemeSwapBound) {
        window.__ckThemeSwapBound = true;
        document.addEventListener("astro:before-swap", (ev) =>
          applyTheme(ev.newDocument),
        );
      }
    </script>

    <style is:global>
      body {
        font-family: "Inter", sans-serif;
      }
      #nav-progress-bar {
        position: fixed;
        top: 0;
        left: 0;
        height: 2px;
        width: 0%;
        z-index: 9999;
        opacity: 0;
        pointer-events: none;
        transition:
          width 220ms ease-out,
          opacity 200ms ease-out;
      }
      #nav-progress-bar.active {
        opacity: 1;
        width: 78%;
      }
      #nav-progress-bar.done {
        opacity: 0;
        width: 100%;
      }
    </style>
  </head>

  <body class="bg-[#F8F9FA] text-zinc-900 dark:bg-[#121212] dark:text-zinc-200 antialiased min-h-screen flex flex-col overflow-x-hidden">
    <div id="nav-progress-bar" class="bg-zinc-900 dark:bg-white"></div>

    <nav class="w-full fixed top-0 z-40 bg-[#F8F9FA]/90 dark:bg-[#121212]/90 backdrop-blur-md border-b border-zinc-200/60 dark:border-zinc-800/60 transition-colors duration-300">
      <div class="max-w-7xl mx-auto px-6 md:px-12 py-5 flex items-center justify-between gap-4">
        <button
          id="mobile-menu-open"
          aria-label="Open menu"
          class="md:hidden p-2 -ml-2 text-zinc-900 dark:text-white cursor-pointer"
        >
          <svg
            class="w-6 h-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"
            ></path>
          </svg>
        </button>

        <a
          href="/"
          data-astro-prefetch="load"
          class="text-zinc-900 dark:text-white font-black tracking-[0.2em] uppercase text-sm hover:opacity-70 transition-opacity shrink-0"
        >
          CK // Vault
        </a>

        <div class="hidden md:flex items-center gap-8 text-[11px] font-bold uppercase tracking-[0.2em]">
          {navItems.map((item) => (
            <a
              href={item.href}
              data-astro-prefetch="load"
              class={`relative py-1 transition-colors ${
                item.active
                  ? "text-zinc-900 dark:text-white"
                  : "text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white"
              }`}
            >
              {item.label}
              {item.active && (
                <span class="absolute left-0 right-0 -bottom-1 h-0.5 bg-zinc-900 dark:bg-white"></span>
              )}
            </a>
          ))}

          <div class="w-px h-4 bg-zinc-300 dark:bg-zinc-700"></div>

          <button
            aria-label="Toggle theme"
            class="theme-toggle-btn p-2 text-zinc-900 dark:text-white hover:opacity-70 transition-opacity cursor-pointer"
          >
            <svg
              class="w-4 h-4 theme-icon"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            ></svg>
          </button>
        </div>

        <button
          aria-label="Toggle theme"
          class="theme-toggle-btn md:hidden p-2 -mr-2 text-zinc-900 dark:text-white hover:opacity-70 transition-opacity cursor-pointer"
        >
          <svg
            class="w-5 h-5 theme-icon"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          ></svg>
        </button>
      </div>
    </nav>

    <div
      id="mobile-overlay"
      class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 opacity-0 pointer-events-none transition-opacity duration-300"
    ></div>

    <div
      id="mobile-drawer"
      class="fixed top-0 left-0 w-72 h-full bg-[#F8F9FA] dark:bg-[#121212] z-50 transform -translate-x-full transition-transform duration-300 shadow-2xl flex flex-col border-r border-zinc-200/60 dark:border-zinc-800/60"
    >
      <div class="flex items-center justify-between p-6 border-b border-zinc-200/60 dark:border-zinc-800/60 shrink-0">
        <span class="text-xs font-black tracking-[0.25em] uppercase text-zinc-900 dark:text-white">
          Navigation
        </span>
        <button
          id="mobile-menu-close"
          aria-label="Close menu"
          class="p-2 -mr-2 text-zinc-900 dark:text-white hover:opacity-70 transition-opacity cursor-pointer"
        >
          <svg
            class="w-6 h-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"
            ></path>
          </svg>
        </button>
      </div>

      <div class="flex flex-col gap-6 p-8 text-sm font-bold uppercase tracking-[0.2em]">
        {navItems.map((item) => (
          <a
            href={item.href}
            data-astro-prefetch="load"
            class={`mobile-nav-link transition-colors ${
              item.active
                ? "text-zinc-900 dark:text-white"
                : "text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white"
            }`}
          >
            {item.label}
          </a>
        ))}
      </div>
    </div>

    <main class="grow w-full pt-24 md:pt-28 z-0 relative">
      <slot />
    </main>

    <footer class="w-full relative overflow-hidden bg-white dark:bg-[#0A0A0A] border-t border-zinc-200/60 dark:border-zinc-800/60 pt-16 pb-10 transition-colors duration-300 mt-auto z-10">
      <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-full overflow-hidden pointer-events-none select-none opacity-[0.03] dark:opacity-[0.02] flex justify-center z-0">
        <span class="text-[18vw] font-black tracking-tighter leading-none whitespace-nowrap text-zinc-900 dark:text-white">
          CHATHURA
        </span>
      </div>
      <div class="max-w-7xl mx-auto px-6 md:px-12 relative z-10 flex flex-col md:flex-row justify-between gap-14 md:gap-8">
        <div class="flex flex-col items-start max-w-sm">
          <a
            href="/"
            class="text-zinc-900 dark:text-white font-black tracking-[0.3em] uppercase text-xl mb-5 hover:opacity-70 transition-opacity"
          >
            CK // Vault
          </a>
          <p class="text-zinc-500 dark:text-zinc-400 text-sm font-medium leading-relaxed mb-6">
            Software Engineering, Networking & Cybersecurity. Focused on building
            reliable systems and practical solutions.
          </p>
          <div class="flex items-center gap-3 text-[10px] font-bold tracking-[0.2em] uppercase text-zinc-600 dark:text-zinc-500">
            <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse shadow-[0_0_8px_rgba(34,197,94,0.6)]"></span>
            AVAILABLE FOR OPPORTUNITIES
          </div>
        </div>
        <div class="flex gap-16 md:gap-24">
          <div class="flex flex-col gap-4 text-xs font-bold tracking-[0.2em] uppercase">
            <h4 class="text-zinc-900 dark:text-white mb-2 border-b border-zinc-200 dark:border-zinc-800 pb-3">
              Sitemap
            </h4>
            <a
              href="/"
              class="text-zinc-500 hover:text-zinc-900 dark:hover:text-white transition-colors"
            >
              Home
            </a>
            <a
              href="/vault"
              class="text-zinc-500 hover:text-zinc-900 dark:hover:text-white transition-colors"
            >
              The Vault
            </a>
            <a
              href="/credentials"
              class="text-zinc-500 hover:text-zinc-900 dark:hover:text-white transition-colors"
            >
              Credentials
            </a>
            <a
              href="/about"
              class="text-zinc-500 hover:text-zinc-900 dark:hover:text-white transition-colors"
            >
              About
            </a>
            <a
              href="/contact"
              class="text-zinc-500 hover:text-zinc-900 dark:hover:text-white transition-colors"
            >
              Contact
            </a>
          </div>
          <div class="flex flex-col gap-4 text-xs font-bold tracking-[0.2em] uppercase">
            <h4 class="text-zinc-900 dark:text-white mb-2 border-b border-zinc-200 dark:border-zinc-800 pb-3">
              Network
            </h4>
            <a
              href="https://github.com/chathura-kulathunga"
              target="_blank"
              rel="noopener noreferrer"
              class="text-zinc-500 hover:text-zinc-900 dark:hover:text-white transition-colors"
            >
              GitHub
            </a>
            <a
              href="https://linkedin.com/in/chathura-kulathunga-b75817276"
              target="_blank"
              rel="noopener noreferrer"
              class="text-zinc-500 hover:text-[#0A66C2] transition-colors"
            >
              LinkedIn
            </a>
            <a
              href="https://www.instagram.com/_chathura_pramuditha_/"
              target="_blank"
              rel="noopener noreferrer"
              class="text-zinc-500 hover:text-[#E1306C] transition-colors"
            >
              Instagram
            </a>
            <a
              href="mailto:chathurakulathunga.foxc@gmail.com"
              class="text-zinc-500 hover:text-zinc-900 dark:hover:text-white transition-colors"
            >
              Email
            </a>
          </div>
        </div>
      </div>
      <div class="max-w-7xl mx-auto px-6 md:px-12 mt-16 flex flex-col md:flex-row items-center justify-between gap-6 text-[10px] font-bold tracking-[0.2em] uppercase text-zinc-500 relative z-10 border-t border-zinc-200/60 dark:border-zinc-800/60 pt-8">
        <p>
          © {new Date().getFullYear()} Chathura Kulathunga. All Rights Reserved.
        </p>
        <button
          id="back-to-top"
          class="hover:text-zinc-900 dark:hover:text-white transition-colors flex items-center gap-3 group cursor-pointer"
        >
          <span class="w-8 h-px bg-zinc-400 group-hover:bg-zinc-900 dark:group-hover:bg-white transition-colors"></span>
          Back To Top
          <svg
            class="w-4 h-4 group-hover:-translate-y-1 transition-transform"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M5 10l7-7m0 0l7 7m-7-7v18"
            ></path>
          </svg>
        </button>
      </div>
    </footer>

    <script>
      const closeMenuGlobal = () => {
        document
          .getElementById("mobile-drawer")
          ?.classList.add("-translate-x-full");
        document
          .getElementById("mobile-overlay")
          ?.classList.add("opacity-0", "pointer-events-none");
        document.body.style.overflow = "";
      };

      const setupLayoutDOM = () => {
        const openBtn = document.getElementById("mobile-menu-open");
        const closeBtn = document.getElementById("mobile-menu-close");
        const drawer = document.getElementById("mobile-drawer");
        const overlay = document.getElementById("mobile-overlay");
        const mobileLinks = document.querySelectorAll(".mobile-nav-link");
        const backToTopBtn = document.getElementById("back-to-top");
        const themeButtons = document.querySelectorAll(".theme-toggle-btn");

        const openMenu = () => {
          drawer?.classList.remove("-translate-x-full");
          overlay?.classList.remove("opacity-0", "pointer-events-none");
          document.body.style.overflow = "hidden";
        };

        if (openBtn && !openBtn.dataset.bound) {
          openBtn.dataset.bound = "true";
          openBtn.addEventListener("click", openMenu);
        }
        if (closeBtn && !closeBtn.dataset.bound) {
          closeBtn.dataset.bound = "true";
          closeBtn.addEventListener("click", closeMenuGlobal);
        }
        if (overlay && !overlay.dataset.bound) {
          overlay.dataset.bound = "true";
          overlay.addEventListener("click", closeMenuGlobal);
        }

        mobileLinks.forEach((link) => {
          const el = link as HTMLElement;
          if (el.dataset.bound) return;
          el.dataset.bound = "true";
          el.addEventListener("click", closeMenuGlobal);
        });

        if (backToTopBtn && !backToTopBtn.dataset.bound) {
          backToTopBtn.dataset.bound = "true";
          backToTopBtn.addEventListener("click", () => {
            window.scrollTo({ top: 0, behavior: "smooth" });
          });
        }

        const updateIcons = () => {
          const isDark = document.documentElement.classList.contains("dark");
          themeButtons.forEach((btn) => {
            const icon = btn.querySelector(".theme-icon");
            if (!icon) return;
            icon.innerHTML = isDark
              ? '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>'
              : '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>';
          });
        };

        themeButtons.forEach((btn) => {
          const el = btn as HTMLElement;
          if (el.dataset.bound) return;
          el.dataset.bound = "true";
          el.addEventListener("click", () => {
            document.documentElement.classList.toggle("dark");
            const isDark = document.documentElement.classList.contains("dark");
            localStorage.setItem("theme", isDark ? "dark" : "light");
            document.documentElement.style.colorScheme = isDark
              ? "dark"
              : "light";
            updateIcons();
          });
        });

        updateIcons();
      };

      if (!(window as any).__ckLayoutBound) {
        (window as any).__ckLayoutBound = true;

        document.addEventListener("astro:before-preparation", () => {
          const bar = document.getElementById("nav-progress-bar");
          if (bar) {
            bar.classList.remove("done");
            bar.classList.add("active");
          }
          closeMenuGlobal();
        });

        document.addEventListener("astro:page-load", () => {
          const bar = document.getElementById("nav-progress-bar");
          if (bar) {
            bar.classList.remove("active");
            bar.classList.add("done");
            setTimeout(() => bar.classList.remove("done"), 250);
          }
          setupLayoutDOM();
        });

        window.addEventListener("resize", () => {
          if (window.innerWidth >= 768) closeMenuGlobal();
        });
      }

      setupLayoutDOM();
    </script>
  </body>
</html>
