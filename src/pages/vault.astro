---
import { sanityClient } from 'sanity:client';
import Layout from '../layouts/Layout.astro';
import { optimizedImg } from '../lib/sanity';

const [
  projects,
  labs,
  robotics,
  milestones,
  music,
  psychology,
] = await Promise.all([
  sanityClient.fetch(`*[_type == "softwareProject" && defined(slug.current) && isVisible != false] | order(coalesce(displayOrder, 999) asc, _createdAt desc)`),
  sanityClient.fetch(`*[_type == "cyberLab" && defined(slug.current) && isVisible != false] | order(coalesce(displayOrder, 999) asc, _createdAt desc)`),
  sanityClient.fetch(`*[_type == "roboticsProject" && defined(slug.current) && isVisible != false] | order(coalesce(displayOrder, 999) asc, _createdAt desc)`),
  sanityClient.fetch(`*[_type == "dojoMilestone" && defined(slug.current) && isVisible != false] | order(coalesce(displayOrder, 999) asc, date desc)`),
  sanityClient.fetch(`*[_type == "musicProject" && defined(slug.current) && isVisible != false] | order(coalesce(displayOrder, 999) asc, _createdAt desc)`),
  sanityClient.fetch(`*[_type == "psychologyEntry" && defined(slug.current) && isVisible != false] | order(coalesce(displayOrder, 999) asc, date desc)`),
]);

const allItems = [
  ...projects.map((item: any) => ({
    sector: 'software',
    label: 'Software',
    accent: 'neutral',
    href: `/project/${item.slug.current}`,
    title: item.title,
    summary: item.description || 'View full system documentation.',
    image: item.mainImage,
  })),
  ...labs.map((item: any) => ({
    sector: 'cybersecurity',
    label: 'Cybersec',
    accent: 'red',
    href: `/labs/${item.slug.current}`,
    title: item.title,
    summary: item.executiveSummary || 'View full security report.',
    image: item.coverImage,
  })),
  ...robotics.map((item: any) => ({
    sector: 'robotics',
    label: 'Robotics',
    accent: 'neutral',
    href: `/robotics/${item.slug.current}`,
    title: item.title,
    summary: item.summary || 'View hardware build documentation.',
    image: item.coverImage,
  })),
  ...milestones.map((item: any) => ({
    sector: 'sports',
    label: 'Shotokan',
    accent: 'amber',
    href: `/dojo/${item.slug.current}`,
    title: item.title,
    summary: item.shortSummary || 'View 1st Dan milestone records inside.',
    image: item.coverImage,
  })),
  ...music.map((item: any) => ({
    sector: 'music',
    label: 'Music',
    accent: 'neutral',
    href: `/music/${item.slug.current}`,
    title: item.title,
    summary: item.summary || 'View audio session notes.',
    image: item.coverImage,
  })),
  ...psychology.map((item: any) => ({
    sector: 'psychology',
    label: 'Psychology',
    accent: 'neutral',
    href: `/psychology/${item.slug.current}`,
    title: item.title,
    summary: item.summary || 'Read full behavioral writeup.',
    image: item.coverImage,
  })),
];

const sectorMeta: Record<string, { title: string; subtitle: string; count: number }> = {
  all: {
    title: 'The Vault.',
    subtitle: 'Software, networking labs, hardware builds, and personal records.',
    count: allItems.length,
  },
  software: {
    title: 'Software Architecture.',
    subtitle: 'Full-stack web systems, desktop tools, and mobile applications.',
    count: projects.length,
  },
  cybersecurity: {
    title: 'Offensive Security.',
    subtitle: 'Vulnerability research, network labs, and penetration testing writeups.',
    count: labs.length,
  },
  robotics: {
    title: 'Hardware & Robotics.',
    subtitle: 'ESP32, Arduino, wireless telemetry, and embedded sensor builds.',
    count: robotics.length,
  },
  sports: {
    title: 'Sports & Martial Arts.',
    subtitle: '1st Dan Shotokan Karate training, instruction, and field sports.',
    count: milestones.length,
  },
  music: {
    title: 'Music & Audio.',
    subtitle: 'Centered on electric guitar and keyboard practice, alongside small custom sound builds.',
    count: music.length,
  },
  psychology: {
    title: 'Behavioral Science.',
    subtitle: 'Continuous study of the human mind, practical support for people, and meditation.',
    count: psychology.length,
  },
};

const tabs = [
  { id: 'all', label: 'All Works' },
  { id: 'software', label: 'Software' },
  { id: 'cybersecurity', label: 'Cybersec' },
  { id: 'robotics', label: 'Robotics' },
  { id: 'sports', label: 'Sports' },
  { id: 'music', label: 'Music' },
  { id: 'psychology', label: 'Psychology' },
];
---

<Layout title="The Vault | CK">
  <section class="max-w-7xl mx-auto px-6 md:px-12 py-10 md:py-14 min-h-screen">

    <header class="mb-8">
      <h1 id="vault-heading" class="text-4xl md:text-5xl font-black text-zinc-900 dark:text-white tracking-tight mb-3">
        The Vault.
      </h1>
      <p id="vault-subtitle" class="text-zinc-500 dark:text-zinc-400 max-w-2xl text-sm md:text-base">
        Selected engineering systems, offensive security labs, hardware builds, and discipline records.
      </p>
    </header>

    {/* Single Clean Filter Bar */}
    <div class="flex items-center gap-2 overflow-x-auto pb-4 mb-10 border-b border-zinc-200/70 dark:border-zinc-800/70 hide-scrollbar">
      {tabs.map((tab) => (
        <button
          type="button"
          data-sector-tab={tab.id}
          class="vault-tab px-4 py-2 rounded-full text-[11px] font-black uppercase tracking-[0.18em] whitespace-nowrap transition-all cursor-pointer border border-zinc-200 dark:border-zinc-800 text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white"
        >
          {tab.label}
          <span class="ml-1.5 opacity-60">{sectorMeta[tab.id].count}</span>
        </button>
      ))}
    </div>

    {/* Unified Project Grid */}
    <ul id="vault-grid" class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-12">
      {allItems.map((item) => (
        <li data-item-sector={item.sector} class="vault-card group">
          <a href={item.href} data-astro-prefetch="viewport" class="block w-full">
            <div class={`w-full aspect-4/3 bg-zinc-200 dark:bg-zinc-900 rounded-2xl overflow-hidden mb-5 relative shadow-sm ${item.accent === 'red' ? 'border border-red-500/20' : 'border border-zinc-200/60 dark:border-zinc-800/60'}`}>
              {item.image && (
                <img
                  src={optimizedImg(item.image, 900, 675)}
                  alt={item.title}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                />
              )}
            </div>
            <span class={`text-[11px] font-black uppercase tracking-[0.2em] mb-2 block ${item.accent === 'red' ? 'text-red-500' : item.accent === 'amber' ? 'text-amber-600 dark:text-amber-500' : 'text-zinc-400 dark:text-zinc-500'}`}>
              {item.label}
            </span>
            <h2 class="text-2xl font-bold text-zinc-900 dark:text-white mb-2.5 group-hover:opacity-70 transition-opacity">
              {item.title}
            </h2>
            <p class="text-sm text-zinc-500 dark:text-zinc-400 mb-4 line-clamp-2 leading-relaxed">
              {item.summary}
            </p>
            <div class={`h-0.5 w-12 group-hover:w-28 transition-all duration-500 ${item.accent === 'red' ? 'bg-red-500' : item.accent === 'amber' ? 'bg-amber-500' : 'bg-zinc-900 dark:bg-white'}`}></div>
          </a>
        </li>
      ))}
    </ul>

    {/* Clean Public Empty State (No Admin Text) */}
    <div id="vault-empty" class="hidden py-20 text-center max-w-md mx-auto">
      <p class="text-sm font-semibold text-zinc-500 dark:text-zinc-400 mb-6">
        Public entries for this sector are currently being curated.
      </p>
      <button
        type="button"
        id="vault-reset-btn"
        class="px-5 py-2.5 rounded-full border border-zinc-300 dark:border-zinc-700 text-xs font-black uppercase tracking-[0.2em] text-zinc-900 dark:text-white hover:bg-zinc-100 dark:hover:bg-zinc-900 transition-colors cursor-pointer"
      >
        ← View All Works
      </button>
    </div>

  </section>

  <script id="vault-meta-json" type="application/json" set:html={JSON.stringify(sectorMeta)}></script>

  <script>
    const validSectors = ['all', 'software', 'cybersecurity', 'robotics', 'sports', 'music', 'psychology'];

    const initVault = () => {
      if (!window.location.pathname.startsWith('/vault')) return;

      const params = new URLSearchParams(window.location.search);
      if (params.get('sector') === 'credentials') {
        window.location.replace('/credentials');
        return;
      }

      const metaEl = document.getElementById('vault-meta-json');
      const sectorMeta = metaEl ? JSON.parse(metaEl.textContent || '{}') : {};
      const heading = document.getElementById('vault-heading');
      const subtitle = document.getElementById('vault-subtitle');
      const tabs = document.querySelectorAll('.vault-tab');
      const cards = document.querySelectorAll('.vault-card');
      const emptyBox = document.getElementById('vault-empty');
      const resetBtn = document.getElementById('vault-reset-btn');

      const applySector = (sector: string, pushHistory = false) => {
        const safe = validSectors.includes(sector) ? sector : 'all';

        if (pushHistory) {
          const targetUrl = safe === 'all' ? '/vault' : `/vault?sector=${safe}`;
          if (window.location.pathname + window.location.search !== targetUrl) {
            window.history.pushState({ sector: safe }, '', targetUrl);
          }
        }

        if (heading && sectorMeta[safe]) heading.textContent = sectorMeta[safe].title;
        if (subtitle && sectorMeta[safe]) subtitle.textContent = sectorMeta[safe].subtitle;

        tabs.forEach((tab) => {
          const active = tab.getAttribute('data-sector-tab') === safe;
          tab.classList.toggle('bg-zinc-900', active);
          tab.classList.toggle('text-white', active);
          tab.classList.toggle('border-zinc-900', active);
          tab.classList.toggle('dark:bg-white', active);
          tab.classList.toggle('dark:text-zinc-900', active);
          tab.classList.toggle('dark:border-white', active);
          tab.classList.toggle('text-zinc-500', !active);
          tab.classList.toggle('dark:text-zinc-400', !active);
        });

        let visibleCount = 0;
        cards.forEach((card) => {
          const show = safe === 'all' || card.getAttribute('data-item-sector') === safe;
          card.classList.toggle('hidden', !show);
          if (show) visibleCount++;
        });

        emptyBox?.classList.toggle('hidden', visibleCount > 0);
      };

      tabs.forEach((tab) => {
        const el = tab as HTMLElement;
        if (el.dataset.bound) return;
        el.dataset.bound = 'true';
        el.addEventListener('click', () => {
          applySector(el.getAttribute('data-sector-tab') || 'all', true);
        });
      });

      if (resetBtn && !resetBtn.dataset.bound) {
        resetBtn.dataset.bound = 'true';
        resetBtn.addEventListener('click', () => applySector('all', true));
      }

      const initialSector = params.get('sector') || 'all';
      applySector(initialSector, false);

      if ((window as any).__ckVaultPopHandler) {
        window.removeEventListener('popstate', (window as any).__ckVaultPopHandler);
      }
      (window as any).__ckVaultPopHandler = () => {
        if (!window.location.pathname.startsWith('/vault')) return;
        const p = new URLSearchParams(window.location.search);
        applySector(p.get('sector') || 'all', false);
      };
      window.addEventListener('popstate', (window as any).__ckVaultPopHandler);
    };

    if (!(window as any).__ckVaultLoadBound) {
      (window as any).__ckVaultLoadBound = true;
      document.addEventListener('astro:page-load', initVault);
    }
    initVault();
  </script>

  <style>
    .hide-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .hide-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
  </style>
</Layout>