---
import { sanityClient } from 'sanity:client';
import Layout from '../layouts/Layout.astro';
import { optimizedImg } from '../lib/sanity';

const credentials = await sanityClient.fetch(
  `*[_type == "credential" && isVisible != false] | order(coalesce(displayOrder, 999) asc, sortDate desc, _createdAt desc)`
);

const categoryLabels: Record<string, string> = {
  cybersecurity: 'Cybersec',
  software: 'Software',
  psychology: 'Psychology',
  sports: 'Sports',
  robotics: 'Robotics',
  music: 'Music',
};

const activeCategories = Array.from(
  new Set(credentials.map((c: any) => c.category).filter(Boolean))
) as string[];
---

<Layout title="Credentials & Honors | CK Vault">
  <section class="max-w-7xl mx-auto px-6 md:px-12 py-10 md:py-14 min-h-screen">

    <header class="mb-10">
      <h1 class="text-4xl md:text-5xl font-black text-zinc-900 dark:text-white tracking-tight mb-3">
        Credentials & Honors.
      </h1>
      <p class="text-zinc-500 dark:text-zinc-400 max-w-2xl text-sm md:text-base">
        Academic degrees, technical certifications, specialized diplomas, and martial arts awards.
      </p>
    </header>

    {credentials.length > 0 ? (
      <>
        {activeCategories.length > 1 && (
          <div class="flex items-center gap-2 overflow-x-auto pb-4 mb-10 border-b border-zinc-200/70 dark:border-zinc-800/70 hide-scrollbar">
            <button
              type="button"
              data-cert-filter="all"
              class="cert-filter-btn px-4 py-2 rounded-full text-[11px] font-black uppercase tracking-[0.18em] whitespace-nowrap border transition-colors cursor-pointer bg-zinc-900 text-white border-zinc-900 dark:bg-white dark:text-zinc-900 dark:border-white"
            >
              All ({credentials.length})
            </button>
            {activeCategories.map((cat) => (
              <button
                type="button"
                data-cert-filter={cat}
                class="cert-filter-btn px-4 py-2 rounded-full text-[11px] font-black uppercase tracking-[0.18em] whitespace-nowrap border border-zinc-200 dark:border-zinc-800 text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white transition-colors cursor-pointer"
              >
                {categoryLabels[cat] || cat}
              </button>
            ))}
          </div>
        )}

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {credentials.map((cert: any) => {
            const allImgs = [
              cert.certificateImage ? optimizedImg(cert.certificateImage, 1400) : null,
              ...(cert.galleryImages || []).map((g: any) => optimizedImg(g, 1400)),
            ].filter(Boolean);

            return (
              <article
                data-cert-category={cert.category || 'software'}
                class="cert-card flex flex-col justify-between p-6 rounded-2xl bg-white dark:bg-[#161616] border border-zinc-200/80 dark:border-zinc-800 transition-all hover:border-zinc-400 dark:hover:border-zinc-600"
              >
                <div>
                  {cert.certificateImage && (
                    <button
                      type="button"
                      data-cert-images={JSON.stringify(allImgs)}
                      data-cert-title={cert.title}
                      class="cert-preview-trigger block w-full aspect-16/10 mb-5 rounded-xl overflow-hidden bg-zinc-100 dark:bg-zinc-900 cursor-pointer group relative"
                    >
                      <img
                        src={optimizedImg(cert.certificateImage, 700, 440)}
                        alt={cert.title}
                        loading="lazy"
                        decoding="async"
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      />
                      {allImgs.length > 1 && (
                        <span class="absolute bottom-2 right-2 px-2.5 py-1 rounded-full bg-black/75 text-white text-[10px] font-bold tracking-wider">
                          +{allImgs.length - 1} more
                        </span>
                      )}
                    </button>
                  )}

                  <div class="flex items-center justify-between gap-2 mb-3">
                    <span class="text-[10px] font-black uppercase tracking-[0.2em] text-zinc-400 dark:text-zinc-500">
                      {cert.dateLabel}
                    </span>
                    {cert.status === 'upcoming' ? (
                      <span class="text-[9px] font-black uppercase tracking-widest px-2.5 py-0.5 rounded-full bg-amber-100 dark:bg-amber-950/60 text-amber-700 dark:text-amber-400">
                        Upcoming
                      </span>
                    ) : (
                      <span class="text-[9px] font-black uppercase tracking-widest px-2.5 py-0.5 rounded-full bg-zinc-100 dark:bg-zinc-900 text-zinc-600 dark:text-zinc-400">
                        {categoryLabels[cert.category] || cert.category}
                      </span>
                    )}
                  </div>

                  <h2 class="text-lg font-bold text-zinc-900 dark:text-white leading-snug mb-1.5">
                    {cert.title}
                  </h2>
                  {cert.issuer && (
                    <p class="text-xs font-semibold text-zinc-500 dark:text-zinc-400 mb-3">{cert.issuer}</p>
                  )}
                  {cert.summary && (
                    <p class="text-xs text-zinc-500 dark:text-zinc-400 leading-relaxed mb-4">{cert.summary}</p>
                  )}
                </div>

                {(allImgs.length > 0 || cert.verificationUrl) && (
                  <div class="flex items-center gap-4 pt-4 mt-2 border-t border-zinc-100 dark:border-zinc-800/80">
                    {allImgs.length > 0 && (
                      <button
                        type="button"
                        data-cert-images={JSON.stringify(allImgs)}
                        data-cert-title={cert.title}
                        class="cert-preview-trigger text-[10px] font-black uppercase tracking-[0.2em] text-zinc-900 dark:text-white hover:opacity-70 transition-opacity cursor-pointer"
                      >
                        Inspect Proof →
                      </button>
                    )}
                    {cert.verificationUrl && (
                      <a
                        href={cert.verificationUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-[10px] font-black uppercase tracking-[0.2em] text-zinc-500 hover:text-zinc-900 dark:hover:text-white transition-colors ml-auto"
                      >
                        Verify ↗
                      </a>
                    )}
                  </div>
                )}
              </article>
            );
          })}
        </div>
      </>
    ) : (
      <div class="py-20 text-center max-w-md mx-auto border border-zinc-200/80 dark:border-zinc-800 rounded-2xl px-6">
        <p class="text-sm font-semibold text-zinc-500 dark:text-zinc-400 mb-6">
          Verified certificates and transcripts are currently being archived.
        </p>
        <a
          href="/vault"
          data-astro-prefetch="load"
          class="inline-block px-5 py-2.5 rounded-full bg-zinc-900 dark:bg-white text-white dark:text-zinc-900 text-xs font-black uppercase tracking-[0.2em] hover:opacity-85 transition-opacity"
        >
          Explore The Vault →
        </a>
      </div>
    )}

  </section>

  <div id="cert-lightbox" class="fixed inset-0 z-100 hidden bg-black/95 backdrop-blur-md items-center justify-center p-4">
    <div class="relative max-w-4xl w-full flex flex-col items-center">
      <div class="w-full flex items-center justify-between mb-4 text-white">
        <p id="cert-lightbox-title" class="text-xs font-bold uppercase tracking-[0.2em] truncate pr-4"></p>
        <button id="cert-lightbox-close" aria-label="Close preview" class="p-2 rounded-full bg-white/10 hover:bg-white/20 transition-colors cursor-pointer">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      <img id="cert-lightbox-img" src="" alt="Certificate Preview" class="max-h-[75vh] w-auto object-contain rounded-lg border border-zinc-800 shadow-2xl" />
      <div id="cert-lightbox-thumbs" class="flex gap-2 mt-4 overflow-x-auto max-w-full py-1"></div>
    </div>
  </div>

  <script>
    const initCredentials = () => {
      if (!window.location.pathname.startsWith('/credentials')) return;

      const filterBtns = document.querySelectorAll('.cert-filter-btn');
      const cards = document.querySelectorAll('.cert-card');

      filterBtns.forEach((btn) => {
        const el = btn as HTMLElement;
        if (el.dataset.bound) return;
        el.dataset.bound = 'true';
        el.addEventListener('click', () => {
          const filter = el.getAttribute('data-cert-filter') || 'all';
          filterBtns.forEach((b) => {
            const active = b.getAttribute('data-cert-filter') === filter;
            b.classList.toggle('bg-zinc-900', active);
            b.classList.toggle('text-white', active);
            b.classList.toggle('border-zinc-900', active);
            b.classList.toggle('dark:bg-white', active);
            b.classList.toggle('dark:text-zinc-900', active);
            b.classList.toggle('dark:border-white', active);
            b.classList.toggle('text-zinc-500', !active);
            b.classList.toggle('dark:text-zinc-400', !active);
          });
          cards.forEach((c) => {
            const cat = c.getAttribute('data-cert-category');
            c.classList.toggle('hidden', filter !== 'all' && cat !== filter);
          });
        });
      });

      const lightbox = document.getElementById('cert-lightbox');
      const lightboxImg = document.getElementById('cert-lightbox-img') as HTMLImageElement | null;
      const lightboxTitle = document.getElementById('cert-lightbox-title');
      const lightboxThumbs = document.getElementById('cert-lightbox-thumbs');
      const closeBtn = document.getElementById('cert-lightbox-close');

      const closeLightbox = () => {
        lightbox?.classList.add('hidden');
        document.body.style.overflow = '';
      };

      document.querySelectorAll('.cert-preview-trigger').forEach((trigger) => {
        const el = trigger as HTMLElement;
        if (el.dataset.bound) return;
        el.dataset.bound = 'true';
        el.addEventListener('click', () => {
          if (!lightbox || !lightboxImg || !lightboxTitle || !lightboxThumbs) return;
          const imgs: string[] = JSON.parse(el.getAttribute('data-cert-images') || '[]');
          if (!imgs.length) return;
          lightboxTitle.textContent = el.getAttribute('data-cert-title') || '';
          lightboxImg.src = imgs[0];
          lightboxThumbs.innerHTML = '';

          if (imgs.length > 1) {
            imgs.forEach((src, i) => {
              const thumb = document.createElement('button');
              thumb.type = 'button';
              thumb.className = `w-14 h-10 rounded overflow-hidden border-2 cursor-pointer ${i === 0 ? 'border-white' : 'border-zinc-700 opacity-70 hover:opacity-100'}`;
              thumb.innerHTML = `<img src="${src}" class="w-full h-full object-cover" />`;
              thumb.onclick = () => {
                lightboxImg.src = src;
                Array.from(lightboxThumbs.children).forEach((child, idx) => {
                  child.className = `w-14 h-10 rounded overflow-hidden border-2 cursor-pointer ${idx === i ? 'border-white' : 'border-zinc-700 opacity-70 hover:opacity-100'}`;
                });
              };
              lightboxThumbs.appendChild(thumb);
            });
          }

          lightbox.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
        });
      });

      if (closeBtn && !closeBtn.dataset.bound) {
        closeBtn.dataset.bound = 'true';
        closeBtn.addEventListener('click', closeLightbox);
      }
      if (lightbox && !lightbox.dataset.bound) {
        lightbox.dataset.bound = 'true';
        lightbox.addEventListener('click', (e) => {
          if (e.target === lightbox) closeLightbox();
        });
      }
    };

    if (!(window as any).__ckCredLoadBound) {
      (window as any).__ckCredLoadBound = true;
      document.addEventListener('astro:page-load', initCredentials);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          document.getElementById('cert-lightbox')?.classList.add('hidden');
          document.body.style.overflow = '';
        }
      });
    }
    initCredentials();
  </script>

  <style>
    .hide-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .hide-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    #cert-lightbox:not(.hidden) {
      display: flex;
    }
  </style>
</Layout>