---
import { sanityClient } from 'sanity:client';
import VaultDetailLayout from '../../components/VaultDetailLayout.astro';

export async function getStaticPaths() {
  const projects = await sanityClient.fetch(`*[_type == "softwareProject" && defined(slug.current) && isVisible != false]`);
  return projects.map((project: any) => ({
    params: { slug: project.slug.current },
    props: { project },
  }));
}

const { project } = Astro.props as any;
---

<VaultDetailLayout
  title={project.title}
  pageTitle={`${project.title} | Software | CK Vault`}
  sectorLabel="Software Architecture"
  sectorSlug="software"
  tags={project.techStack}
  coverImage={project.mainImage}
  summary={project.description}
  summaryLabel="Architecture Summary"
  body={project.body}
  primaryLink={project.githubUrl ? { label: 'View GitHub Repository', url: project.githubUrl } : undefined}
  secondaryLink={project.liveUrl ? { label: 'Open Live Demo', url: project.liveUrl } : undefined}
/>