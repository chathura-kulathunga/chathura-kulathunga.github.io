---
import { sanityClient } from 'sanity:client';
import VaultDetailLayout from '../../components/VaultDetailLayout.astro';

export async function getStaticPaths() {
  const milestones = await sanityClient.fetch(`*[_type == "dojoMilestone" && defined(slug.current) && isVisible != false]`);
  return milestones.map((milestone: any) => ({
    params: { slug: milestone.slug.current },
    props: { milestone },
  }));
}

const { milestone } = Astro.props as any;
const formattedDate = milestone.date
  ? `Recorded: ${new Date(milestone.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}`
  : '';
---

<VaultDetailLayout
  title={milestone.title}
  pageTitle={`${milestone.title} | The Dojo | CK Vault`}
  sectorLabel="Shotokan Karate"
  sectorSlug="sports"
  accent="amber"
  dateLabel={formattedDate}
  coverImage={milestone.coverImage}
  summary={milestone.shortSummary}
  summaryLabel="Milestone Overview"
  body={milestone.description}
  gallery={milestone.gallery}
/>