---
import { sanityClient } from 'sanity:client';
import VaultDetailLayout from '../../components/VaultDetailLayout.astro';

export async function getStaticPaths() {
  const labs = await sanityClient.fetch(`*[_type == "cyberLab" && defined(slug.current) && isVisible != false]`);
  return labs.map((lab: any) => ({
    params: { slug: lab.slug.current },
    props: { lab },
  }));
}

const { lab } = Astro.props as any;
---

<VaultDetailLayout
  title={lab.title}
  pageTitle={`${lab.title} | Cyber Lab | CK Vault`}
  sectorLabel="Offensive Security"
  sectorSlug="cybersecurity"
  accent="red"
  tags={lab.toolsUsed}
  coverImage={lab.coverImage}
  summary={lab.executiveSummary}
  summaryLabel="Executive Summary"
  body={lab.body}
  primaryLink={lab.reportUrl ? { label: 'View Full Writeup', url: lab.reportUrl } : undefined}
/>