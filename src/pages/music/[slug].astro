---
import { sanityClient } from 'sanity:client';
import VaultDetailLayout from '../../components/VaultDetailLayout.astro';

export async function getStaticPaths() {
  const items = await sanityClient.fetch(`*[_type == "musicProject" && defined(slug.current) && isVisible != false]`);
  return items.map((item: any) => ({
    params: { slug: item.slug.current },
    props: { item },
  }));
}

const { item } = Astro.props as any;
---

<VaultDetailLayout
  title={item.title}
  pageTitle={`${item.title} | Music | CK Vault`}
  sectorLabel="Music & Audio"
  sectorSlug="music"
  tags={item.gearUsed}
  coverImage={item.coverImage}
  summary={item.summary}
  summaryLabel="Session Notes"
  body={item.body}
  primaryLink={item.mediaUrl ? { label: 'Listen / Watch', url: item.mediaUrl } : undefined}
/>