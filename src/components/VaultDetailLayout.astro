---
import { PortableText } from 'astro-portabletext';
import Layout from '../layouts/Layout.astro';
import SanityPortableImage from './SanityPortableImage.astro';
import { optimizedImg } from '../lib/sanity';

interface ActionLink {
  label: string;
  url: string;
}

interface Props {
  title: string;
  pageTitle: string;
  sectorLabel: string;
  sectorSlug: string;
  accent?: 'neutral' | 'red' | 'amber';
  dateLabel?: string;
  tags?: string[];
  coverImage?: any;
  summary?: string;
  summaryLabel?: string;
  body?: any;
  gallery?: any[];
  primaryLink?: ActionLink;
  secondaryLink?: ActionLink;
}

const {
  title,
  pageTitle,
  sectorLabel,
  sectorSlug,
  accent = 'neutral',
  dateLabel,
  tags = [],
  coverImage,
  summary,
  summaryLabel = 'Overview',
  body,
  gallery = [],
  primaryLink,
  secondaryLink,
} = Astro.props;

const tagClasses =
  accent === 'red'
    ? 'bg-red-50 dark:bg-red-950/30 border border-red-200 dark:border-red-900 text-red-700 dark:text-red-400'
    : accent === 'amber'
    ? 'bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-900 text-amber-700 dark:text-amber-400'
    : 'bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-700 text-zinc-700 dark:text-zinc-300';

const portableComponents = {
  type: {
    image: SanityPortableImage,
  },
};
---

<Layout title={pageTitle}>
  <div class="max-w-4xl mx-auto px-6 md:px-16 py-10 md:py-14">

    <a
      href={`/vault?sector=${sectorSlug}`}
      data-astro-prefetch="load"
      class="inline-flex items-center gap-2 text-xs font-black text-zinc-500 hover:text-zinc-900 dark:hover:text-white mb-10 transition-colors uppercase tracking-[0.2em]"
    >
      <span>←</span>
      <span>Back to {sectorLabel}</span>
    </a>

    <header class="mb-10">
      <span class={`text-[10px] font-black uppercase tracking-[0.3em] block mb-3 ${accent === 'red' ? 'text-red-500' : accent === 'amber' ? 'text-amber-500' : 'text-zinc-400 dark:text-zinc-500'}`}>
        {sectorLabel}
      </span>
      <h1 class="text-3xl md:text-5xl lg:text-6xl font-black text-zinc-900 dark:text-white mb-5 tracking-tight leading-tight">
        {title}
      </h1>

      {dateLabel && (
        <div class="text-xs font-bold tracking-[0.2em] uppercase text-zinc-500 dark:text-zinc-400 mb-6">
          {dateLabel}
        </div>
      )}

      {tags && tags.length > 0 && (
        <div class="flex flex-wrap gap-2">
          {tags.map((tag) => (
            <span class={`px-3.5 py-1.5 rounded-md text-[11px] font-bold uppercase tracking-wider ${tagClasses}`}>
              {tag}
            </span>
          ))}
        </div>
      )}
    </header>

    {coverImage && (
      <div class="w-full mb-12 rounded-2xl overflow-hidden border border-zinc-200 dark:border-zinc-800 shadow-xl bg-zinc-100 dark:bg-zinc-900">
        <img
          src={optimizedImg(coverImage, 1280)}
          alt={title}
          fetchpriority="high"
          decoding="async"
          class="w-full h-auto max-h-[65vh] object-cover"
        />
      </div>
    )}

    {summary && (
      <div class={`mb-10 p-6 rounded-r-xl bg-zinc-100/80 dark:bg-zinc-900/80 border-l-4 ${accent === 'red' ? 'border-red-500' : accent === 'amber' ? 'border-amber-500' : 'border-zinc-900 dark:border-white'}`}>
        <h2 class="text-xs font-black text-zinc-900 dark:text-white mb-2 uppercase tracking-[0.25em]">
          {summaryLabel}
        </h2>
        <p class="text-zinc-700 dark:text-zinc-300 leading-relaxed font-medium">
          {summary}
        </p>
      </div>
    )}

    {body && (
      <article class="prose max-w-none
                      [&>h1]:text-3xl [&>h1]:font-bold [&>h1]:text-zinc-900 dark:[&>h1]:text-white [&>h1]:mt-12 [&>h1]:mb-5
                      [&>h2]:text-2xl [&>h2]:font-bold [&>h2]:text-zinc-800 dark:[&>h2]:text-zinc-100 [&>h2]:mt-10 [&>h2]:mb-4
                      [&>h3]:text-xl [&>h3]:font-bold [&>h3]:text-zinc-800 dark:[&>h3]:text-zinc-200 [&>h3]:mt-8 [&>h3]:mb-3
                      [&>p]:text-zinc-600 dark:[&>p]:text-zinc-400 [&>p]:leading-relaxed [&>p]:mb-6
                      [&>ul]:list-disc [&>ul]:pl-6 [&>ul]:mb-6 [&>ul]:text-zinc-600 dark:[&>ul]:text-zinc-400
                      [&>ol]:list-decimal [&>ol]:pl-6 [&>ol]:mb-6 [&>ol]:text-zinc-600 dark:[&>ol]:text-zinc-400
                      [&>li]:mb-2 [&>strong]:text-zinc-900 dark:[&>strong]:text-white
                      [&>blockquote]:border-l-4 [&>blockquote]:border-zinc-300 dark:[&>blockquote]:border-zinc-700 [&>blockquote]:pl-4 [&>blockquote]:italic">
        <PortableText value={body} components={portableComponents} />
      </article>
    )}

    {gallery && gallery.length > 0 && (
      <section class="mt-14 pt-10 border-t border-zinc-200 dark:border-zinc-800">
        <h2 class="text-xs font-black uppercase tracking-[0.3em] text-zinc-400 dark:text-zinc-500 mb-6">
          Visual Records
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {gallery.map((photo, idx) => (
            <div class="rounded-xl overflow-hidden border border-zinc-200 dark:border-zinc-800 bg-zinc-100 dark:bg-zinc-900">
              <img
                src={optimizedImg(photo, 900)}
                alt={`${title} photo ${idx + 1}`}
                loading="lazy"
                decoding="async"
                class="w-full h-64 object-cover hover:scale-105 transition-transform duration-500"
              />
            </div>
          ))}
        </div>
      </section>
    )}

    {(primaryLink || secondaryLink) && (
      <div class="mt-14 pt-8 border-t border-zinc-200 dark:border-zinc-800 flex flex-wrap gap-4">
        {primaryLink && (
          <a
            href={primaryLink.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 bg-zinc-900 dark:bg-white text-white dark:text-black text-xs font-black uppercase tracking-[0.2em] rounded-lg hover:opacity-80 transition-opacity"
          >
            {primaryLink.label} ↗
          </a>
        )}
        {secondaryLink && (
          <a
            href={secondaryLink.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 border border-zinc-300 dark:border-zinc-700 text-zinc-900 dark:text-white text-xs font-black uppercase tracking-[0.2em] rounded-lg hover:bg-zinc-100 dark:hover:bg-zinc-900 transition-colors"
          >
            {secondaryLink.label} ↗
          </a>
        )}
      </div>
    )}

  </div>
</Layout>